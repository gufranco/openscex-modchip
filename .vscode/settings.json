{
  "files.associations": {
    "*.h": "c",
    "*.S": "asm-collection"
  },
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.compilerPath": "",
  "C_Cpp.default.includePath": ["${workspaceFolder}/include"],
  "C_Cpp.default.defines": [
    "__AVR_ATtiny84__",
    "F_CPU=8000000UL",
    "PSCU_TIMING_ADAPTIVE=1",
    "PSCU_WFCK_PERIODS_PER_BIT=30",
    "PSCU_VCD_FILTER=0"
  ],
  "[c]": {
    "editor.formatOnSave": false
  }
}
