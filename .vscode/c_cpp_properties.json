{
  "version": 4,
  "configurations": [
    {
      "name": "firmware-default (ATtiny85, internal 8MHz, us, adaptive, no BIOS)",
      "includePath": ["${workspaceFolder}/include"],
      "defines": [
        "__AVR_ATtiny85__",
        "F_CPU=8000000UL",
        "PSCU_TIMING_ADAPTIVE=1",
        "PSCU_WFCK_PERIODS_PER_BIT=30",
        "PSCU_BIOS_ENABLED=0",
        "PSCU_BIOS_TWO_PHASE=0"
      ],
      "compilerPath": "",
      "cStandard": "c17"
    }
  ]
}
